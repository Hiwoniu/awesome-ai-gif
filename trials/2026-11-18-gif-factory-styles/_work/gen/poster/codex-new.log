    each.add_argument("work", type=Path, help="工作目录")
    each.add_argument("--image", type=Path, action="append", help="每张都带的参考图（如主角照片），排在 ref.png 前面")
    each.add_argument("--only", nargs="*", help="只画这些子目录")
